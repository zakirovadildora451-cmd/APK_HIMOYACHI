<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.apkhimoyachi.security">

    <!-- O'rnatilgan ilovalarni tahlil qilish uchun (Android 11+) -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Xotiradagi va Telegramdagi APK fayllarni skanerlash -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Bildirishnomalar ruxsati (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Favqulodda qo'ng'iroq / signal ko'rinishidagi ogohlantirish (Full Screen Alert) -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Real vaqtda orqa fonda himoya xizmati -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- DIQQAT: INTERNET ruxsati mavjud emas! 100% oflayn va shaxsiy ma'lumotlar to'planmaydi. -->

    <application
        android:name=".ApkHimoyachiApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ApkHimoyachi">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ApkHimoyachi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Telegram yoki yuklamalardan virusli APK tushganda ochiluvchi FAVQULODDA QO'NG'IROQ oynasi -->
        <activity
            android:name=".ui.CallAlertActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.ApkHimoyachi" />

        <!-- Real vaqt rejimida yangi ilovalar o'rnatilishini kuzatuvchi Receiver -->
        <receiver
            android:name=".receiver.PackageInstallReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <action android:name="android.intent.action.PACKAGE_REPLACED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <!-- Real vaqtda himoya va Telegram/Downloads fayllarini kuzatish xizmati -->
        <service
            android:name=".service.RealtimeProtectionService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Real-time security scan of downloaded APKs and app installations" />
        </service>

    </application>

</manifest>
